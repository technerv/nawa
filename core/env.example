DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Pagination
DJANGO_PAGE_SIZE=10

# Database (leave empty to use SQLite)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=nawa
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_HOST=127.0.0.1
# DB_PORT=5432

# CORS
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Role permissions
ENFORCE_ROLE_PERMS=False

# Public mode
PUBLIC_MODE=False
PUBLIC_THROTTLE_RATE=60/min

# Celery (Redis broker)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# SMS Providers (choose one or both)
# Africa's Talking (Kenya-focused)
AFRICAS_TALKING_API_KEY=your-api-key
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_SHORTCODE=
# Twilio (fallback/international)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1234567890

# Email Provider (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@nawa.local
SENDGRID_FROM_NAME=Neighbourhood Alert Watch App

# Push Notifications (FCM)
FCM_SERVER_KEY=your-fcm-server-key
FCM_PROJECT_ID=your-fcm-project-id

